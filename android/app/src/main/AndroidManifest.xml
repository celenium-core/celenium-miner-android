<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The app reads the stratum bridge's HTTP dashboard at an address the
         user types in Node settings. Without this permission every poll
         fails with a socket error that looks like a dead bridge. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- The ad SDK checks connectivity before requesting a fill. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <!-- Foreground mining: wakelock keeps the CPU hashing, the service stays
         alive when the activity is swiped away, and Android 13+ needs a
         runtime request to show the persistent notification. -->
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <application
        android:label="Celenium Miner"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:localeConfig="@xml/locales_config"
        android:usesCleartextTraffic="true"
        android:allowBackup="false">
        <!-- allowBackup=false keeps the app out of Auto Backup: after a
             reinstall the Keystore master key is never restored (it cannot
             be), so a backed-up EncryptedSharedPreferences blob only ever
             decrypts to BadPaddingException — the boot-time crash we fixed
             in Keystore. The recovery phrase exists as written-down words,
             not as a transportable blob. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- AdMob app id. Must match the app registered in the AdMob console
             (ca-app-pub-5168743842779308~5416336913), or every request fails
             with "Invalid application id". -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-5168743842779308~5416336913"/>
        <!-- Runs the miner in the background so hashing survives the app being
             closed. The class lives in the flutter_foreground_task AAR; only
             its declaration belongs here. dataSync keeps it alive on Android
             14+ with the matching permission above. -->
        <service
            android:name="com.pravera.flutter_foreground_task.service.ForegroundService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
