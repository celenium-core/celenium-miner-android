/build/
/.dart_tool/
/.idea/
*.iml
.flutter-plugins-dependencies

# Native lib dirs a wayward unzip or the Android release build drops next to
# the Dart sources. Ignoring bare /lib/ once hid the whole Dart tree from git.
/lib/arm64-v8a/
/lib/armeabi-v7a/
/lib/x86_64/
/lib/*.so

# APK decompile dumps (dex/kotlin/res) that land in the repo root when a
# release build is inspected for AdMob id and locales.
/classes.dex
/resources.arsc
/AndroidManifest.xml
/DebugProbesKt.bin
/hsdp.properties
/kotlin-tooling-metadata.json
/play-services-*.properties
/user-messaging-platform.properties
/res/
/kotlin/
/META-INF/
/assets/dexopt/
/assets/flutter_assets/

# UI review screenshots dumped to the repo root during testing.
/cen_*.png
/navbar_fix_*.png
/preview_desktop.png

# Golden-test failure artifacts (diff/oops images) flutter test writes here.
/test/failures/

# Desktop platform scaffolding from `flutter create`/`build` — this repo is
# android-only; the desktop app lives in celenium-miner-desktop.
/linux/
/windows/